// ── Sequence ────────────────────────────────────────────────────

namespace behave.actions;

table SequenceArgs {}

table SequenceResult {
    success: bool;
    children_completed: uint;
    failed_at_index: int;
}

table SequenceState {
    current_index: uint;
}

table SequenceInput {}

table SequenceOutput {
    progress_pct: double;
    current_step: uint;
    total_steps: uint;
}
