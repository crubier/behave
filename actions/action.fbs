// ── Action Tree FlatBuffer Schema ──────────────────────────────
//
// Wire format for behavior trees sent from GCS to the robot.
// Each action folder defines its own 5 types (Args, Result, State,
// Input, Output). This root schema imports them all and defines
// the union types and tree node tables.

include "sequence/sequence.fbs";
include "fallback/fallback.fbs";
include "takeoff/takeoff.fbs";
include "land/land.fbs";
include "goto_waypoint/goto_waypoint.fbs";
include "return_home/return_home.fbs";
include "take_photo/take_photo.fbs";

namespace behave.actions;

// ── Args ────────────────────────────────────────────────────────

union ActionArgsType {
    SequenceArgs,
    FallbackArgs,
    TakeoffArgs,
    LandArgs,
    GotoWaypointArgs,
    ReturnHomeArgs,
    TakePhotoArgs
}

table ActionArgs {
    id: ulong;
    name: string;
    action: ActionArgsType;
    children: [ActionArgs];
}

// ── Result ──────────────────────────────────────────────────────

union ActionResultType {
    SequenceResult,
    FallbackResult,
    TakeoffResult,
    LandResult,
    GotoWaypointResult,
    ReturnHomeResult,
    TakePhotoResult
}

table ActionResult {
    id: ulong;
    result: ActionResultType;
    children: [ActionResult];
}

// ── State ───────────────────────────────────────────────────────

union ActionStateType {
    SequenceState,
    FallbackState,
    TakeoffState,
    LandState,
    GotoWaypointState,
    ReturnHomeState,
    TakePhotoState
}

table ActionState {
    id: ulong;
    state: ActionStateType;
    children: [ActionState];
}

// ── Input ───────────────────────────────────────────────────────

union ActionInputType {
    SequenceInput,
    FallbackInput,
    TakeoffInput,
    LandInput,
    GotoWaypointInput,
    ReturnHomeInput,
    TakePhotoInput
}

table ActionInput {
    id: ulong;
    input: ActionInputType;
    children: [ActionInput];
}

// ── Output ──────────────────────────────────────────────────────

union ActionOutputType {
    SequenceOutput,
    FallbackOutput,
    TakeoffOutput,
    LandOutput,
    GotoWaypointOutput,
    ReturnHomeOutput,
    TakePhotoOutput
}

table ActionOutput {
    id: ulong;
    output: ActionOutputType;
    children: [ActionOutput];
}

root_type ActionArgs;
